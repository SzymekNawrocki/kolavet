---
import { NavClient } from './NavClient';
import { navLinks, getLocalePaths, detectLocale } from '../../lib/i18n';

const currentPath = Astro.url.pathname;
const currentLocale = detectLocale(currentPath);

const localePaths = getLocalePaths(currentPath);
const links = navLinks[currentLocale];
const homeHref = currentLocale === 'pl' ? '/' : `/${currentLocale}/`;
---

<header class="sticky top-0 z-50 border-b border-border bg-dark/90 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-[1200px] items-center justify-between gap-8 px-6">

    <a
      href={homeHref}
      class="shrink-0 font-serif text-xl font-bold text-cyan focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan"
      aria-label="Kolavet — strona główna"
    >
      Kolavet
    </a>

    <NavClient
      currentPath={currentPath}
      currentLocale={currentLocale}
      localePaths={localePaths}
      links={links}
      client:load
    />

  </div>
</header>
