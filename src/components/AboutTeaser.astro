---
import { Image } from 'astro:assets';
import { Button } from './ui/button';
import { getAboutMe } from '../lib/cms';

interface Props {
  lang?: 'pl' | 'en' | 'de';
}
const { lang = 'pl' } = Astro.props;

const about = await getAboutMe();

const photo    = about?.photo ?? '/images/photo.jpeg';
const rawHead  = lang === 'en' ? about?.en_heading : lang === 'de' ? about?.de_heading : about?.heading;
const rawIntro = lang === 'en' ? about?.en_intro   : lang === 'de' ? about?.de_intro   : about?.intro;

const defaults = {
  pl: { heading: 'Cześć, jestem Michalina',  intro: 'Lekarz weterynarii z pasją do edukacji właścicieli zwierząt. Na tym blogu dzielę się wiedzą, by pomóc Ci zadbać o zdrowie Twojego pupila.', cta: 'Więcej o mnie', href: '/o-mnie' },
  en: { heading: "Hi, I'm Michalina",         intro: "A veterinarian passionate about educating pet owners. On this blog I share knowledge to help you take care of your pet's health.",           cta: 'More about me', href: '/en/about' },
  de: { heading: 'Hallo, ich bin Michalina',  intro: 'Tierärztin mit Leidenschaft für Tierhalter. In diesem Blog teile ich Wissen, um Ihnen bei der Gesundheitsfürsorge für Ihr Haustier zu helfen.', cta: 'Mehr über mich', href: '/de/about' },
}[lang];

const heading = rawHead  || defaults.heading;
const intro   = rawIntro || defaults.intro;

const interests = {
  pl: ['Koty', 'Psy', 'Egzotyczne', 'Profilaktyka'],
  en: ['Cats', 'Dogs', 'Exotic Pets', 'Prevention'],
  de: ['Katzen', 'Hunde', 'Exoten', 'Vorbeugung'],
}[lang];
---

<section class="relative isolate overflow-hidden">
  <!-- Gradient top divider -->
  <div class="absolute left-0 right-0 top-0 h-px bg-gradient-to-r from-transparent via-border to-transparent" aria-hidden="true" />

  <!-- Elevated surface -->
  <div class="absolute inset-0 bg-surface-light/30" aria-hidden="true" />

  <!-- Ambient glow behind photo side -->
  <div
    class="pointer-events-none absolute left-0 top-1/2 h-[600px] w-[600px] -translate-x-1/3 -translate-y-1/2 rounded-full bg-cyan/6 blur-[120px]"
    aria-hidden="true"
  />

  <!-- Gradient bottom divider -->
  <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-border to-transparent" aria-hidden="true" />

  <div class="relative z-10 mx-auto max-w-[1200px] px-6 py-20 md:py-28">
    <div class="flex flex-col items-center gap-14 md:flex-row md:items-start md:gap-20">

      <!-- Photo column with two image slots -->
      <div class="flex shrink-0 flex-col items-center gap-4 md:items-start">

        <!-- Main portrait with glow ring -->
        <div class="relative">
          <div
            class="absolute inset-0 -m-6 rounded-3xl bg-cyan/10 blur-2xl [animation:glowPulse_5s_ease-in-out_infinite]"
            aria-hidden="true"
          />
          <Image
            src={photo}
            alt="Michalina Kolarz"
            width={260}
            height={325}
            class="relative aspect-[4/5] w-[220px] rounded-2xl border border-border/60 object-cover object-top shadow-deep md:w-[260px]"
            loading="lazy"
            decoding="async"
            inferSize={false}
          />
        </div>

        <!-- Second image slot — clinic / animal photo -->
        <div class="relative ml-auto w-[140px] overflow-hidden rounded-xl border border-border/60 bg-surface-light md:w-[165px]">
          <div class="aspect-[4/3] w-full [background-image:radial-gradient(circle,rgba(0,217,255,0.07)_1px,transparent_1px)] [background-size:16px_16px]" />
          <div class="absolute inset-0 bg-gradient-to-br from-cyan/6 via-transparent to-pink/4" aria-hidden="true" />
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="h-12 w-12 rounded-full bg-cyan/12 blur-2xl" aria-hidden="true" />
          </div>
        </div>

      </div>

      <!-- Text content -->
      <div class="flex flex-col gap-5 text-center md:text-left">
        <p class="reveal text-xs font-semibold uppercase tracking-[0.2em] text-cyan [animation:slideInRight_0.6s_ease_both]">
          {lang === 'pl' ? 'O autorce' : lang === 'de' ? 'Über mich' : 'About the author'}
        </p>
        <h2 class="reveal font-serif text-[2rem] font-bold tracking-[-0.5px] text-bright [animation:slideInRight_0.6s_0.1s_ease_both] md:text-[2.5rem] md:tracking-[-0.7px]">
          {heading}
        </h2>
        <p class="reveal max-w-[520px] text-base leading-relaxed text-secondary [animation:slideInRight_0.6s_0.15s_ease_both]">
          {intro}
        </p>

        <!-- Specialties -->
        <ul class="reveal flex flex-wrap justify-center gap-2 [animation:slideInRight_0.6s_0.2s_ease_both] md:justify-start" aria-label="Zainteresowania">
          {interests.map(s => (
            <li class="flex items-center gap-1.5 rounded-full border border-border bg-surface-medium px-3 py-1.5 text-xs font-semibold text-secondary">
              <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-cyan" aria-hidden="true" />
              {s}
            </li>
          ))}
        </ul>

        <div class="reveal flex justify-center [animation:slideInRight_0.6s_0.25s_ease_both] md:justify-start">
          <Button variant="outline" asChild>
            <a href={defaults.href}>{defaults.cta}</a>
          </Button>
        </div>
      </div>

    </div>
  </div>
</section>
