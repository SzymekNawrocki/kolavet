---
const links = [
  { href: '/',        label: 'Strona główna' },
  { href: '/blog',    label: 'Blog' },
  { href: '/o-mnie',  label: 'O mnie' },
  { href: '/kontakt', label: 'Kontakt' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-border bg-cream/85 backdrop-blur-sm">
  <div class="mx-auto flex h-16 max-w-[1120px] items-center justify-between gap-8 px-6">

    <a
      href="/"
      class="shrink-0 font-serif text-xl font-bold text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sage"
      aria-label="Kolavet — strona główna"
    >
      Kolavet
    </a>

    <button
      id="nav-hamburger"
      class="flex h-11 w-11 flex-col items-center justify-center gap-[5px] rounded bg-transparent md:hidden focus-visible:outline-2 focus-visible:outline-sage"
      aria-label="Otwórz menu"
      aria-expanded="false"
      aria-controls="nav-menu"
    >
      <span class="block h-0.5 w-[22px] rounded-sm bg-ink transition-transform duration-200"></span>
      <span class="block h-0.5 w-[22px] rounded-sm bg-ink transition-opacity duration-200"></span>
      <span class="block h-0.5 w-[22px] rounded-sm bg-ink transition-transform duration-200"></span>
    </button>

    <nav
      id="nav-menu"
      class="hidden md:flex"
      role="navigation"
      aria-label="Główna nawigacja"
    >
      <ul class="flex items-center gap-1" role="list">
        {links.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class:list={[
                'rounded px-3 py-2 text-[0.9375rem] font-medium transition-colors duration-150 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sage',
                currentPath === href ? 'text-sage' : 'text-ink hover:text-sage',
              ]}
              aria-current={currentPath === href ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

  </div>
</header>

<!-- Mobile menu (below header, full-width) -->
<div
  id="nav-mobile"
  class="hidden border-b border-border bg-cream px-6 py-4 md:hidden"
>
  <ul class="flex flex-col gap-1" role="list">
    {links.map(({ href, label }) => (
      <li>
        <a
          href={href}
          class:list={[
            'block w-full rounded px-2 py-3 text-[0.9375rem] font-medium transition-colors duration-150',
            currentPath === href ? 'text-sage' : 'text-ink hover:text-sage',
          ]}
          aria-current={currentPath === href ? 'page' : undefined}
        >
          {label}
        </a>
      </li>
    ))}
  </ul>
</div>

<script>
  const btn    = document.getElementById('nav-hamburger') as HTMLButtonElement;
  const mobile = document.getElementById('nav-mobile') as HTMLElement;

  btn?.addEventListener('click', () => {
    const isOpen = mobile.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(isOpen));
    btn.setAttribute('aria-label', isOpen ? 'Zamknij menu' : 'Otwórz menu');
  });
</script>
