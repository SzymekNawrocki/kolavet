---
import { NavClient } from './NavClient';
import { navLinks, getLocalePaths, type Locale } from '../lib/i18n';

const currentPath = Astro.url.pathname;

let currentLocale: Locale = 'pl';
if (currentPath.startsWith('/en')) currentLocale = 'en';
else if (currentPath.startsWith('/de')) currentLocale = 'de';

const localePaths = getLocalePaths(currentPath);
const links = navLinks[currentLocale];
const homeHref = currentLocale === 'pl' ? '/' : `/${currentLocale}/`;
---

<header class="sticky top-0 z-50 border-b border-border bg-cream/85 backdrop-blur-sm">
  <div class="mx-auto flex h-16 max-w-[1120px] items-center justify-between gap-8 px-6">

    <a
      href={homeHref}
      class="shrink-0 font-serif text-xl font-bold text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sage"
      aria-label="Kolavet — strona główna"
    >
      Kolavet
    </a>

    <NavClient
      currentPath={currentPath}
      currentLocale={currentLocale}
      localePaths={localePaths}
      links={links}
      client:load
    />

  </div>
</header>
