---
import { Button } from './ui/button';
import { Input } from './ui/input';

interface Props {
  lang?: 'pl' | 'en' | 'de';
}
const { lang = 'pl' } = Astro.props;

const t = {
  pl: {
    eyebrow:     'Newsletter',
    heading:     'Bądź na bieżąco',
    body:        'Nowe artykuły o zdrowiu zwierząt prosto na Twoją skrzynkę.',
    placeholder: 'Twój adres e-mail',
    inputLabel:  'Adres e-mail',
    cta:         'Zapisz się',
    legal:       'Bez spamu. Możesz wypisać się w każdej chwili.',
    success:     'Zapisano! Sprawdź skrzynkę.',
    error:       'Coś poszło nie tak. Spróbuj ponownie.',
  },
  en: {
    eyebrow:     'Newsletter',
    heading:     'Stay up to date',
    body:        'New articles on animal health delivered straight to your inbox.',
    placeholder: 'Your email address',
    inputLabel:  'Email address',
    cta:         'Subscribe',
    legal:       'No spam. Unsubscribe at any time.',
    success:     'Subscribed! Check your inbox.',
    error:       'Something went wrong. Please try again.',
  },
  de: {
    eyebrow:     'Newsletter',
    heading:     'Bleib informiert',
    body:        'Neue Artikel zur Tiergesundheit direkt in Ihr Postfach.',
    placeholder: 'Ihre E-Mail-Adresse',
    inputLabel:  'E-Mail-Adresse',
    cta:         'Abonnieren',
    legal:       'Kein Spam. Jederzeit abbestellbar.',
    success:     'Angemeldet! Prüfen Sie Ihr Postfach.',
    error:       'Etwas ist schief gelaufen. Bitte versuchen Sie es erneut.',
  },
}[lang];
---

<section class="relative isolate overflow-hidden">
  <div class="absolute left-0 right-0 top-0 h-px bg-gradient-to-r from-transparent via-cyan/40 to-transparent" aria-hidden="true" />
  <div class="absolute inset-0 bg-surface-light/40" aria-hidden="true" />
  <div
    class="pointer-events-none absolute left-1/2 top-1/2 h-[500px] w-[500px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-cyan/8 blur-[120px] [animation:glowPulse_5s_ease-in-out_infinite]"
    aria-hidden="true"
  />
  <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-border to-transparent" aria-hidden="true" />

  <div class="relative z-10 mx-auto max-w-[640px] px-6 py-20 md:py-24 text-center">
    <p class="reveal mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-cyan [animation:fadeInUp_0.6s_ease_both]">
      {t.eyebrow}
    </p>
    <h2 class="reveal font-serif text-[2rem] font-bold tracking-[-0.5px] text-bright [animation:fadeInUp_0.6s_0.1s_ease_both] md:text-[2.5rem] md:tracking-[-0.7px]">
      {t.heading}
    </h2>
    <p class="reveal mx-auto mt-4 max-w-[380px] text-base leading-relaxed text-secondary [animation:fadeInUp_0.6s_0.15s_ease_both]">
      {t.body}
    </p>

    <form
      id="newsletter-form"
      data-success={t.success}
      data-error={t.error}
      class="reveal mt-8 flex flex-col gap-3 sm:flex-row sm:gap-2 [animation:fadeInUp_0.6s_0.2s_ease_both]"
      novalidate
    >
      <Input
        type="email"
        name="email"
        placeholder={t.placeholder}
        aria-label={t.inputLabel}
        required
        className="flex-1"
      />
      <Button type="submit" size="default" className="shrink-0">
        {t.cta}
      </Button>
    </form>

    <p id="newsletter-msg" class="reveal mt-4 text-xs text-muted [animation:fadeInUp_0.6s_0.25s_ease_both]">
      {t.legal}
    </p>
  </div>
</section>

<script>
  const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
  const msg  = document.getElementById('newsletter-msg');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = (form.elements.namedItem('email') as HTMLInputElement).value;
    const successText = form.dataset.success ?? '';
    const errorText   = form.dataset.error   ?? '';

    try {
      const res = await fetch('/api/newsletter', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      if (msg) {
        msg.textContent = res.ok ? successText : errorText;
        msg.style.color = res.ok ? 'var(--color-cyan)' : '#ff6b6b';
      }
      if (res.ok) form.reset();
    } catch {
      if (msg) { msg.textContent = errorText; msg.style.color = '#ff6b6b'; }
    }
  });
</script>
