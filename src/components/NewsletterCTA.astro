---
import { Button } from './ui/button';

interface Props {
  lang?: 'pl' | 'en' | 'de';
  href?: string;
}
const { lang = 'pl', href = '#' } = Astro.props;

const t = {
  pl: { eyebrow: 'Newsletter', heading: 'Bądź na bieżąco', body: 'Nowe artykuły o zdrowiu zwierząt prosto na Twoją skrzynkę.', cta: 'Zapisz się' },
  en: { eyebrow: 'Newsletter', heading: 'Stay up to date',  body: 'New articles on animal health delivered straight to your inbox.', cta: 'Subscribe' },
  de: { eyebrow: 'Newsletter', heading: 'Bleib informiert', body: 'Neue Artikel zur Tiergesundheit direkt in Ihr Postfach.',         cta: 'Abonnieren' },
}[lang];
---

<section class="relative isolate overflow-hidden">
  <!-- Gradient top divider -->
  <div class="absolute left-0 right-0 top-0 h-px bg-gradient-to-r from-transparent via-cyan/40 to-transparent" aria-hidden="true" />

  <!-- Elevated surface background -->
  <div class="absolute inset-0 bg-surface-light/40" aria-hidden="true" />

  <!-- Glow orb -->
  <div
    class="pointer-events-none absolute left-1/2 top-1/2 h-[400px] w-[400px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-cyan/8 blur-[100px] [animation:glowPulse_5s_ease-in-out_infinite]"
    aria-hidden="true"
  />

  <!-- Gradient bottom divider -->
  <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-border to-transparent" aria-hidden="true" />

  <div class="relative z-10 mx-auto max-w-[640px] px-6 py-20 text-center">
    <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-cyan">{t.eyebrow}</p>
    <h2 class="font-serif text-[2rem] font-bold tracking-[-0.5px] text-bright md:text-[2.5rem] md:tracking-[-0.7px]">
      {t.heading}
    </h2>
    <p class="mx-auto mt-4 max-w-[380px] text-base leading-relaxed text-secondary">
      {t.body}
    </p>
    <div class="mt-8">
      <Button asChild size="lg">
        <a href={href}>{t.cta}</a>
      </Button>
    </div>
  </div>
</section>
