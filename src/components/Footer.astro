---
const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-border py-8">
  <div class="mx-auto flex max-w-[1120px] flex-wrap items-center justify-between gap-6 px-6">

    <p class="text-sm font-medium text-muted">
      &copy; {year} Michalina — Kolavet. Wszelkie prawa zastrzeżone.
    </p>

    <nav aria-label="Nawigacja stopki">
      <ul class="flex gap-6" role="list">
        <li>
          <a
            href="/o-mnie"
            class="text-sm font-medium text-muted transition-colors duration-150 hover:text-sage focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sage"
          >
            O mnie
          </a>
        </li>
        <li>
          <a
            href="/kontakt"
            class="text-sm font-medium text-muted transition-colors duration-150 hover:text-sage focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sage"
          >
            Kontakt
          </a>
        </li>
      </ul>
    </nav>

  </div>
</footer>
