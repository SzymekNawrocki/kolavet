---
import { createReader } from '@keystatic/core/reader';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { Button } from '../components/ui/button';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const data = await reader.singletons.faq.read();

const heading = data?.heading || 'Najczęstsze pytania';
const intro   = data?.intro   || 'Pytania, które najczęściej słyszę od właścicieli zwierząt.';
const items   = data?.items   ?? [];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map(item => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<BaseLayout
  title={`${heading} — Kolavet`}
  description="Odpowiedzi na najczęstsze pytania właścicieli zwierząt domowych."
  lang="pl"
>
  {items.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" is:inline />
  )}

  <Nav />

  <main id="main-content">

    <section class="relative overflow-hidden py-16 md:py-24">
      <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
        <div class="absolute -top-20 left-1/2 h-[400px] w-[400px] -translate-x-1/2 rounded-full bg-cyan/8 blur-[120px] [animation:float_12s_ease-in-out_infinite]" />
      </div>
      <div class="relative z-10 mx-auto max-w-[768px] px-6 text-center">
        <p class="mb-4 text-xs font-semibold uppercase tracking-[0.2em] text-cyan [animation:fadeInUp_0.5s_ease_both]">FAQ</p>
        <h1 class="font-serif text-[2.75rem] font-bold leading-tight tracking-[-0.8px] text-bright [animation:fadeInUp_0.6s_0.1s_ease_both] md:text-[3.5rem]">
          {heading}
        </h1>
        {intro && (
          <p class="mt-5 text-lg leading-relaxed text-secondary [animation:fadeInUp_0.6s_0.15s_ease_both]">
            {intro}
          </p>
        )}
      </div>
    </section>

    <div class="mx-auto max-w-[768px] px-6">
      <div class="h-px bg-gradient-to-r from-transparent via-border to-transparent" aria-hidden="true" />
    </div>

    {items.length > 0 ? (
      <section class="mx-auto max-w-[768px] px-6 py-16">
        <dl class="flex flex-col gap-6">
          {items.map((item, i) => (
            <div
              class="rounded-2xl border border-border bg-surface-light p-6 shadow-card [animation:fadeInUp_0.5s_ease_both]"
              style={`animation-delay: ${i * 0.06}s`}
            >
              <dt class="font-serif text-lg font-bold leading-snug text-bright md:text-xl">
                {item.question}
              </dt>
              <dd class="mt-3 text-base leading-relaxed text-secondary">
                {item.answer}
              </dd>
            </div>
          ))}
        </dl>
      </section>
    ) : (
      <p class="mx-auto max-w-[768px] px-6 py-16 text-base text-secondary">Pytania wkrótce.</p>
    )}

    <section class="mx-auto max-w-[768px] px-6 pb-20 text-center">
      <p class="mb-5 text-base text-secondary">Nie znalazłeś odpowiedzi na swoje pytanie?</p>
      <Button asChild>
        <a href="/kontakt">Napisz do mnie</a>
      </Button>
    </section>

  </main>

  <Footer />
</BaseLayout>
