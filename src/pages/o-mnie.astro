---
import { getEntry, render } from 'astro:content';
import { createReader } from '@keystatic/core/reader';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const about = await reader.singletons.aboutMe.read();

const heading = about?.heading ?? 'O mnie';
const intro   = about?.intro   ?? '';
const photo   = about?.photo   ?? '/images/photo.jpeg';

const bioEntry = await getEntry('pages', 'about/bio');
const { Content: BioContent } = bioEntry ? await render(bioEntry) : { Content: null };
---

<BaseLayout
  title={`${heading} — Kolavet`}
  description="Poznaj Michalinę Kolarz — lekarza weterynarii i autorkę bloga Kolavet."
  lang="pl"
>
  <Nav />

  <main id="main-content">

    <!-- Two-column header -->
    <section class="relative overflow-hidden">
      <!-- Ambient glow -->
      <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
        <div class="absolute -left-40 top-1/2 h-[500px] w-[500px] -translate-y-1/2 rounded-full bg-cyan/8 blur-[120px]" />
      </div>

      <div class="relative z-10 mx-auto grid max-w-[1200px] grid-cols-1 items-center gap-12 px-6 py-16 md:grid-cols-2 md:gap-20 md:py-24">

        <!-- Image -->
        <div class="flex justify-center md:justify-start">
          <ImagePlaceholder
            src={photo}
            alt="Michalina Kolarz — lekarz weterynarii"
            width={420}
            height={525}
            loading="eager"
            class="aspect-[4/5] w-full max-w-[340px] md:max-w-[380px]"
          />
        </div>

        <!-- Text -->
        <div class="flex flex-col gap-5 text-center md:text-left">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-cyan">Lekarz weterynarii</p>
          <h1 class="font-serif text-[2.75rem] font-bold leading-tight tracking-[-0.8px] text-bright md:text-[3.5rem] md:tracking-[-1px]">
            {heading}
          </h1>
          {intro && (
            <p class="text-lg leading-relaxed text-secondary">{intro}</p>
          )}
        </div>

      </div>
    </section>

    <!-- Gradient divider -->
    <div class="mx-auto max-w-[1200px] px-6">
      <div class="h-px bg-gradient-to-r from-transparent via-border to-transparent" aria-hidden="true" />
    </div>

    <!-- Bio text — narrow column for readability -->
    {BioContent && (
      <div class="mx-auto max-w-[768px] px-6 py-16">
        <div class="prose prose-invert max-w-none prose-headings:font-serif prose-headings:text-bright prose-a:text-cyan prose-a:no-underline hover:prose-a:text-cyan-dark prose-blockquote:border-l-pink prose-blockquote:italic prose-blockquote:text-secondary">
          <BioContent />
        </div>
      </div>
    )}

  </main>

  <Footer />
</BaseLayout>
