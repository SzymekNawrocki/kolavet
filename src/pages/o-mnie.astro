---
import { getEntry, render } from 'astro:content';
import { createReader } from '@keystatic/core/reader';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const about = await reader.singletons.aboutMe.read();

const heading      = about?.heading      ?? 'O mnie';
const intro        = about?.intro        ?? '';
const photo        = about?.photo        ?? '/images/photo.jpeg';
const defaultJourney = [
  { year: '2019–2024', title: 'Studia weterynaryjne', description: 'Pięć lat nauki na wydziale medycyny weterynaryjnej — od anatomii po chirurgię.' },
  { year: '2024',      title: 'Dyplom lekarza weterynarii', description: 'Obrona pracy dyplomowej i uzyskanie tytułu lek. wet.' },
  { year: '2025',      title: 'Pierwsza praca i ten blog', description: 'Zaczęłam pracę w klinice i postanowiłam dzielić się tym, czego się uczę — stąd Kolavet.' },
];
const journeyItems = (about?.journeyItems ?? []).length > 0 ? (about?.journeyItems ?? []) : defaultJourney;

const bioEntry = await getEntry('pages', 'about/bio');
const { Content: BioContent } = bioEntry ? await render(bioEntry) : { Content: null };
---

<BaseLayout
  title={`${heading} — Kolavet`}
  description="Poznaj Michalinę Kolarz — lekarza weterynarii i autorkę bloga Kolavet."
  lang="pl"
>
  <Nav />

  <main id="main-content">

    <!-- Two-column header -->
    <section class="relative overflow-hidden">
      <!-- Ambient glow -->
      <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
        <div class="absolute -left-40 top-1/2 h-[500px] w-[500px] -translate-y-1/2 rounded-full bg-cyan/8 blur-[120px]" />
      </div>

      <div class="relative z-10 mx-auto grid max-w-[1200px] grid-cols-1 items-center gap-12 px-6 py-16 md:grid-cols-2 md:gap-20 md:py-24">

        <!-- Image -->
        <div class="flex justify-center md:justify-start">
          <ImagePlaceholder
            src={photo}
            alt="Michalina Kolarz — lekarz weterynarii"
            width={420}
            height={525}
            loading="eager"
            class="aspect-[4/5] w-full max-w-[340px] md:max-w-[380px]"
          />
        </div>

        <!-- Text -->
        <div class="flex flex-col gap-5 text-center md:text-left">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-cyan">Lekarz weterynarii</p>
          <h1 class="font-serif text-[2.75rem] font-bold leading-tight tracking-[-0.8px] text-bright md:text-[3.5rem] md:tracking-[-1px]">
            {heading}
          </h1>
          {intro && (
            <p class="text-lg leading-relaxed text-secondary">{intro}</p>
          )}
        </div>

      </div>
    </section>

    <!-- Gradient divider -->
    <div class="mx-auto max-w-[1200px] px-6">
      <div class="h-px bg-gradient-to-r from-transparent via-border to-transparent" aria-hidden="true" />
    </div>

    <!-- Bio text — narrow column for readability -->
    {BioContent && (
      <div class="mx-auto max-w-[768px] px-6 py-16">
        <div class="prose prose-invert max-w-none prose-headings:font-serif prose-headings:text-bright prose-a:text-cyan prose-a:no-underline hover:prose-a:text-cyan-dark prose-blockquote:border-l-pink prose-blockquote:italic prose-blockquote:text-secondary">
          <BioContent />
        </div>
      </div>
    )}

    <section class="mx-auto max-w-[768px] px-6 pb-20">

        <div class="h-px bg-gradient-to-r from-transparent via-border to-transparent" aria-hidden="true" />

        <h2 class="relative mb-10 mt-12 pl-5 font-serif text-[1.875rem] font-bold tracking-[-0.5px] text-bright before:absolute before:bottom-1 before:left-0 before:top-1 before:w-[3px] before:rounded-full before:bg-gradient-to-b before:from-cyan before:to-cyan/0 before:content-['']">
          Moja droga
        </h2>

        <ol class="relative flex flex-col" aria-label="Oś czasu">
          <div class="absolute bottom-2 left-[11px] top-2 w-px bg-border" aria-hidden="true" />

          {journeyItems.map((item, i) => (
            <li
              class="relative flex gap-5 pb-10 last:pb-0 [animation:slideInLeft_0.5s_ease_both]"
              style={`animation-delay: ${i * 0.1}s`}
            >
              <div class="relative mt-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-border bg-surface-light">
                <div class="h-2 w-2 rounded-full bg-cyan [animation:glowPulse_3s_ease-in-out_infinite]" aria-hidden="true" />
              </div>
              <div class="flex flex-col gap-1 pt-0.5">
                <span class="text-xs font-bold uppercase tracking-[0.15em] text-cyan">{item.year}</span>
                <p class="font-serif text-lg font-bold text-bright">{item.title}</p>
                {item.description && (
                  <p class="text-sm leading-relaxed text-secondary">{item.description}</p>
                )}
              </div>
            </li>
          ))}
        </ol>

    </section>

  </main>

  <Footer />
</BaseLayout>
