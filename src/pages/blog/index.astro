---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/nav/Nav.astro';
import Footer from '../../components/nav/Footer.astro';
import { BlogFilter } from '../../components/blog/BlogFilter';
import { getPosts } from '../../lib/posts';

const posts = await getPosts('pl');
---

<BaseLayout
  title="Blog — Kolavet"
  description="Wszystkie artykuły o zdrowiu zwierząt, opiece nad pupilami i poradach weterynaryjnych."
>
  <link rel="alternate" type="application/rss+xml" title="Kolavet RSS" href="/rss.xml" slot="head" />

  <Nav />

  <main id="main-content" class="mx-auto max-w-[1200px] px-6 py-16">
    <header class="mb-12">
      <h1 class="font-serif text-[3rem] font-bold leading-tight tracking-[-0.8px] text-bright">
        Blog
      </h1>
    </header>

    <BlogFilter posts={posts} lang="pl" client:load />
  </main>

  <Footer />
</BaseLayout>
