---
import fs from 'node:fs';
import path from 'node:path';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import AuthorCard from '../../components/AuthorCard.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import NewsletterCTA from '../../components/NewsletterCTA.astro';
import { Badge } from '../../components/ui/badge';
import { PostCard } from '../../components/PostCard';
import { categoryLabels } from '../../lib/i18n';
import { calculateReadingTime } from '../../lib/reading-time';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const sorted = posts.sort(
    (a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
  );
  return sorted.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      prevPost: i < sorted.length - 1
        ? { slug: sorted[i + 1].id, title: sorted[i + 1].data.title }
        : null,
      nextPost: i > 0
        ? { slug: sorted[i - 1].id, title: sorted[i - 1].data.title }
        : null,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content, headings } = await render(post);

let rawContent = '';
try {
  rawContent = fs.readFileSync(
    path.join(process.cwd(), 'src/content/posts', `${post.id}.mdoc`),
    'utf-8'
  );
} catch {}
const readingTime = calculateReadingTime(rawContent, 'pl');

const allPosts = await getCollection('posts');
const related = allPosts
  .filter(p => p.id !== post.id && p.data.category === post.data.category)
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())
  .slice(0, 3)
  .map(p => {
    let raw = '';
    try {
      raw = fs.readFileSync(
        path.join(process.cwd(), 'src/content/posts', `${p.id}.mdoc`),
        'utf-8'
      );
    } catch {}
    return {
      slug:        p.id,
      title:       p.data.title,
      publishDate: p.data.publishDate,
      category:    p.data.category,
      excerpt:     p.data.excerpt,
      coverImage:  p.data.coverImage ?? null,
      readingTime: calculateReadingTime(raw, 'pl'),
    };
  });

const date = new Date(post.data.publishDate).toLocaleDateString('pl-PL', {
  year: 'numeric', month: 'long', day: 'numeric',
});

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.excerpt,
  datePublished: post.data.publishDate,
  author: {
    '@type': 'Person',
    name: 'Michalina',
  },
  ...(post.data.coverImage && { image: post.data.coverImage }),
};
---

<BaseLayout
  title={`${post.data.title} — Kolavet`}
  description={post.data.excerpt}
  ogImage={post.data.coverImage ?? undefined}
  type="article"
  publishDate={post.data.publishDate}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" is:inline />

  <Nav />

  <main id="main-content">
    <article class="mx-auto max-w-[768px] px-6 py-16">

      <nav aria-label="Breadcrumb" class="mb-10">
        <a
          href="/blog"
          class="inline-flex items-center gap-1.5 text-sm font-semibold text-secondary transition-colors hover:text-cyan focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan"
        >
          ← Blog
        </a>
      </nav>

      <header class="mb-10">
        <div class="mb-4 flex flex-wrap items-center gap-3">
          <Badge>{categoryLabels.pl[post.data.category] ?? post.data.category}</Badge>
          <time class="text-sm font-medium text-secondary" datetime={post.data.publishDate}>
            {date}
          </time>
          <span class="text-sm text-muted">{readingTime}</span>
        </div>

        <h1 class="font-serif text-[1.875rem] font-bold leading-[1.10] tracking-[-0.5px] text-bright sm:text-[2.5rem] md:text-[3rem] md:tracking-[-0.8px]">
          {post.data.title}
        </h1>

        <p class="mt-4 text-lg leading-relaxed text-secondary">
          {post.data.excerpt}
        </p>
      </header>

      {post.data.coverImage ? (
        <Image
          src={post.data.coverImage}
          alt=""
          class="mb-12 aspect-video w-full rounded-xl border border-border object-cover"
          width={768}
          height={432}
          loading="eager"
          decoding="async"
          inferSize={false}
        />
      ) : (
        <div class="mb-12 h-1.5 w-full overflow-hidden rounded-full bg-surface-medium" aria-hidden="true">
          <div class="h-full w-full bg-gradient-to-r from-cyan via-pink to-yellow" />
        </div>
      )}

      <ShareButtons
        url={`https://kolavet.pl/blog/${post.id}`}
        title={post.data.title}
        lang="pl"
      />

      <TableOfContents headings={headings} />

      <div class="prose prose-invert max-w-none prose-headings:font-serif prose-headings:text-bright prose-a:text-cyan prose-a:no-underline hover:prose-a:text-cyan-dark prose-blockquote:border-l-pink prose-blockquote:italic prose-blockquote:text-secondary prose-code:rounded prose-code:bg-surface-medium prose-code:text-cyan prose-img:rounded-xl">
        <Content />
      </div>

      <AuthorCard />

    </article>

    <NewsletterCTA lang="pl" />

    {related.length > 0 && (
      <section class="mx-auto max-w-[1200px] border-t border-border px-6 py-16">
        <h2 class="relative mb-8 pl-5 font-serif text-[1.75rem] font-bold tracking-[-0.4px] text-bright before:absolute before:bottom-1 before:left-0 before:top-1 before:w-[3px] before:rounded-full before:bg-gradient-to-b before:from-cyan before:to-cyan/0 before:content-['']">
          Podobne artykuły
        </h2>
        <ul class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3" role="list">
          {related.map(p => (
            <li>
              <PostCard
                slug={p.slug}
                title={p.title}
                publishDate={p.publishDate}
                category={p.category}
                excerpt={p.excerpt}
                coverImage={p.coverImage}
                readingTime={p.readingTime}
              />
            </li>
          ))}
        </ul>
      </section>
    )}
    {(prevPost || nextPost) && (
      <nav
        aria-label="Nawigacja między artykułami"
        class="mx-auto max-w-[768px] border-t border-border px-6 py-10"
      >
        <div class="flex flex-col gap-4 sm:flex-row sm:justify-between">
          {prevPost ? (
            <a
              href={`/blog/${prevPost.slug}`}
              class="group flex max-w-[45%] flex-col gap-1 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan"
            >
              <span class="text-xs font-semibold uppercase tracking-wider text-muted">← Starszy</span>
              <span class="text-sm font-semibold text-secondary transition-colors group-hover:text-cyan line-clamp-2">
                {prevPost.title}
              </span>
            </a>
          ) : <div />}

          {nextPost && (
            <a
              href={`/blog/${nextPost.slug}`}
              class="group flex max-w-[45%] flex-col items-end gap-1 text-right focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan"
            >
              <span class="text-xs font-semibold uppercase tracking-wider text-muted">Nowszy →</span>
              <span class="text-sm font-semibold text-secondary transition-colors group-hover:text-cyan line-clamp-2">
                {nextPost.title}
              </span>
            </a>
          )}
        </div>
      </nav>
    )}

  </main>

  <Footer />
</BaseLayout>
