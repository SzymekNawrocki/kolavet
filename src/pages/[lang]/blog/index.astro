---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import { BlogFilter } from '../../../components/BlogFilter';
import { getPosts } from '../../../lib/posts';
import { LOCALES, type Locale } from '../../../lib/i18n';

export function getStaticPaths() {
  return LOCALES.filter(l => l !== 'pl').map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };

const posts = await getPosts(lang);

const ui: Record<Locale, { title: string; description: string; heading: string }> = {
  pl: { title: '', description: '', heading: 'Blog' },
  en: {
    title:       'Blog — Kolavet',
    description: 'All articles on animal health, pet care and veterinary advice.',
    heading:     'Blog',
  },
  de: {
    title:       'Blog — Kolavet',
    description: 'Alle Artikel zu Tiergesundheit, Haustierpflege und tierärztlichen Ratschlägen.',
    heading:     'Blog',
  },
};

const t = ui[lang];
---

<BaseLayout title={t.title} description={t.description} lang={lang}>
  <link rel="alternate" type="application/rss+xml" title="Kolavet RSS" href="/rss.xml" slot="head" />

  <Nav />

  <main id="main-content" class="mx-auto max-w-[1200px] px-6 py-16">
    <header class="mb-12">
      <h1 class="font-serif text-[3rem] font-bold leading-tight tracking-[-0.8px] text-bright">
        {t.heading}
      </h1>
    </header>

    <BlogFilter posts={posts} lang={lang} client:load />
  </main>

  <Footer />
</BaseLayout>
