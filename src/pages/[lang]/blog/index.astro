---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import { PostCard } from '../../../components/PostCard';
import { LOCALES, type Locale } from '../../../lib/i18n';

export function getStaticPaths() {
  return LOCALES.filter(l => l !== 'pl').map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };

const allPosts = await getCollection('posts');
const posts = allPosts.sort(
  (a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);

const ui: Record<Locale, { title: string; description: string; heading: string; count: (n: number) => string }> = {
  pl: { title: '', description: '', heading: 'Blog', count: n => `${n} artykułów` },
  en: {
    title: 'Blog — Kolavet',
    description: 'All articles on animal health, pet care and veterinary advice.',
    heading: 'Blog',
    count: n => `${n} ${n === 1 ? 'article' : 'articles'}`,
  },
  de: {
    title: 'Blog — Kolavet',
    description: 'Alle Artikel zu Tiergesundheit, Haustierpflege und tierärztlichen Ratschlägen.',
    heading: 'Blog',
    count: n => `${n} ${n === 1 ? 'Artikel' : 'Artikel'}`,
  },
};

const t = ui[lang];
---

<BaseLayout title={t.title} description={t.description} lang={lang}>
  <Nav />

  <main class="mx-auto max-w-[1120px] px-6 py-16">

    <header class="mb-12">
      <h1 class="font-serif text-[2.75rem] font-bold leading-tight tracking-[-1px] text-ink">
        {t.heading}
      </h1>
      <p class="mt-3 text-lg text-muted">{t.count(posts.length)}</p>
    </header>

    {posts.length > 0 ? (
      <ul class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3" role="list">
        {posts.map((post) => (
          <li>
            <PostCard
              slug={post.data.title.slug}
              title={post.data.title.name}
              publishDate={post.data.publishDate}
              category={post.data.category}
              excerpt={post.data.excerpt}
              coverImage={post.data.coverImage}
              basePath="/blog"
              lang={lang}
            />
          </li>
        ))}
      </ul>
    ) : (
      <p class="text-base text-muted">
        {lang === 'de' ? 'Artikel erscheinen bald.' : 'Articles coming soon.'}
      </p>
    )}

  </main>

  <Footer />
</BaseLayout>
