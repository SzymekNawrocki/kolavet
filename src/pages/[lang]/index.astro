---
import { getCollection } from 'astro:content';
import { createReader } from '@keystatic/core/reader';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { PostCard } from '../../components/PostCard';
import { Button } from '../../components/ui/button';
import { Badge } from '../../components/ui/badge';
import ImagePlaceholder from '../../components/ImagePlaceholder.astro';
import AboutTeaser from '../../components/AboutTeaser.astro';
import NewsletterCTA from '../../components/NewsletterCTA.astro';
import { LOCALES, type Locale } from '../../lib/i18n';
import keystaticConfig from '../../../keystatic.config';

export function getStaticPaths() {
  return LOCALES.filter(l => l !== 'pl').map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };

const reader = createReader(process.cwd(), keystaticConfig);
const [hp, aboutMe] = await Promise.all([
  reader.singletons.homePage.read(),
  reader.singletons.aboutMe.read(),
]);

const locData = lang === 'en'
  ? { badge: hp?.en_heroBadgeLabel, headline: hp?.en_heroHeadline, subtext: hp?.en_heroSubtext, cta: hp?.en_heroCtaLabel, blogH: hp?.en_blogSectionHeading, blogCta: hp?.en_blogCtaLabel }
  : { badge: hp?.de_heroBadgeLabel, headline: hp?.de_heroHeadline, subtext: hp?.de_heroSubtext, cta: hp?.de_heroCtaLabel, blogH: hp?.de_blogSectionHeading, blogCta: hp?.de_blogCtaLabel };

const subtextDefaults: Record<Locale, string> = {
  pl: '',
  en: 'Veterinary advice written with passion and care — so your pet stays healthy and happy.',
  de: 'Tierärztliche Ratschläge mit Leidenschaft verfasst — damit Ihr Tier gesund und glücklich bleibt.',
};

const heroBadge    = locData.badge    ?? hp?.heroBadgeLabel    ?? '';
const heroHeadline = locData.headline ?? hp?.heroHeadline      ?? '';
const heroSubtext  = locData.subtext  ?? hp?.heroSubtext       ?? subtextDefaults[lang];
const heroCtaLabel = locData.cta      ?? hp?.heroCtaLabel      ?? 'Browse articles';
const blogHeading  = locData.blogH    ?? hp?.blogSectionHeading ?? '';
const blogCta      = locData.blogCta  ?? hp?.blogCtaLabel      ?? 'Show all';
const heroPhoto    = aboutMe?.photo ?? '/images/photo.jpeg';

const allPosts = await getCollection('posts');
const posts = allPosts
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())
  .slice(0, 3);

const descriptions: Record<Locale, string> = {
  pl: '',
  en: 'Veterinary advice, animal health and pet care — written with passion by a veterinarian.',
  de: 'Tierärztliche Ratschläge, Tiergesundheit und Haustierpflege — mit Leidenschaft von einer Tierärztin verfasst.',
};
---

<BaseLayout
  title="Kolavet — Veterinary blog"
  description={descriptions[lang]}
  lang={lang}
>
  <Nav />

  <main id="main-content">

    <!-- Hero — two-column on desktop -->
    <section class="relative overflow-hidden py-16 md:py-24 lg:py-32">

      <!-- Floating gradient orbs -->
      <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
        <div class="absolute -top-32 left-1/4 h-[600px] w-[600px] -translate-x-1/2 rounded-full bg-cyan/10 blur-[140px] [animation:float_12s_ease-in-out_infinite]" />
        <div class="absolute -right-20 top-1/3 h-[400px] w-[400px] rounded-full bg-pink/8 blur-[120px] [animation:float_16s_ease-in-out_4s_infinite]" />
        <div class="absolute -bottom-20 left-1/2 h-[300px] w-[300px] rounded-full bg-yellow/6 blur-[100px] [animation:float_14s_ease-in-out_8s_infinite]" />
      </div>

      <div class="pointer-events-none absolute bottom-0 left-0 right-0 h-40 bg-gradient-to-t from-dark to-transparent" aria-hidden="true" />

      <div class="relative z-10 mx-auto grid max-w-[1200px] grid-cols-1 items-center gap-12 px-6 md:grid-cols-2 md:gap-16 lg:gap-24">

        <!-- Text column -->
        <div class="flex flex-col items-center gap-6 text-center md:items-start md:text-left">
          <span class="[animation:fadeInUp_0.5s_ease_both]">
            <Badge>{heroBadge}</Badge>
          </span>
          <h1 class="font-serif text-[2.75rem] font-extrabold leading-[1.06] tracking-[-1px] text-bright [animation:fadeInUp_0.65s_0.1s_ease_both] md:text-[3.5rem] md:tracking-[-1.2px] lg:text-[4.25rem] lg:tracking-[-1.5px]">
            {heroHeadline}
          </h1>
          {heroSubtext && (
            <p class="max-w-[520px] text-lg leading-relaxed text-secondary [animation:fadeInUp_0.65s_0.2s_ease_both]">
              {heroSubtext}
            </p>
          )}
          <div class="[animation:fadeInUp_0.65s_0.3s_ease_both]">
            <Button asChild size="lg">
              <a href={`/${lang}/blog`}>{heroCtaLabel}</a>
            </Button>
          </div>
        </div>

        <!-- Image column -->
        <div class="flex justify-center [animation:fadeInUp_0.8s_0.4s_ease_both] md:justify-end">
          <ImagePlaceholder
            src={heroPhoto}
            alt="Michalina Kolarz — veterinarian"
            width={480}
            height={600}
            loading="eager"
            class="aspect-[4/5] w-full max-w-[380px] md:max-w-[420px]"
          />
        </div>

      </div>
    </section>

    <!-- Latest posts -->
    <section class="pb-24 pt-8">
      <div class="mx-auto max-w-[1200px] px-6">
        <div class="mb-8 flex items-baseline justify-between gap-4">
          <h2 class="relative pl-5 font-serif text-[2.25rem] font-bold leading-snug tracking-[-0.5px] text-bright before:absolute before:bottom-1 before:left-0 before:top-1 before:w-[3px] before:rounded-full before:bg-gradient-to-b before:from-cyan before:to-cyan/0 before:content-['']">
            {blogHeading}
          </h2>
          <a
            href={`/${lang}/blog`}
            class="shrink-0 text-sm font-semibold text-cyan transition-colors hover:text-cyan-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan"
          >
            {blogCta} →
          </a>
        </div>
        {posts.length > 0 ? (
          <ul class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3" role="list">
            {posts.map((post) => (
              <li>
                <PostCard
                  slug={post.id}
                  title={post.data.title}
                  publishDate={post.data.publishDate}
                  category={post.data.category}
                  excerpt={post.data.excerpt}
                  coverImage={post.data.coverImage}
                  basePath="/blog"
                  lang={lang}
                />
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-base text-secondary">{lang === 'de' ? 'Artikel erscheinen bald.' : 'Articles coming soon.'}</p>
        )}
      </div>
    </section>

    <AboutTeaser lang={lang} />
    <NewsletterCTA lang={lang} />

  </main>

  <Footer />
</BaseLayout>
