---
import { getCollection } from 'astro:content';
import { createReader } from '@keystatic/core/reader';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { PostCard } from '../../components/PostCard';
import { Button } from '../../components/ui/button';
import { Badge } from '../../components/ui/badge';
import { LOCALES, type Locale } from '../../lib/i18n';
import keystaticConfig from '../../../keystatic.config';

export function getStaticPaths() {
  return LOCALES.filter(l => l !== 'pl').map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };

const reader = createReader(process.cwd(), keystaticConfig);
const hp = await reader.singletons.homePage.read();

const locData = lang === 'en'
  ? { badge: hp?.en_heroBadgeLabel, headline: hp?.en_heroHeadline, subtext: hp?.en_heroSubtext, cta: hp?.en_heroCtaLabel, blogH: hp?.en_blogSectionHeading, blogCta: hp?.en_blogCtaLabel }
  : { badge: hp?.de_heroBadgeLabel, headline: hp?.de_heroHeadline, subtext: hp?.de_heroSubtext, cta: hp?.de_heroCtaLabel, blogH: hp?.de_blogSectionHeading, blogCta: hp?.de_blogCtaLabel };

const heroBadge    = locData.badge    ?? hp?.heroBadgeLabel    ?? '';
const heroHeadline = locData.headline ?? hp?.heroHeadline      ?? '';
const heroSubtext  = locData.subtext  ?? hp?.heroSubtext       ?? '';
const heroCtaLabel = locData.cta      ?? hp?.heroCtaLabel      ?? 'Browse articles';
const blogHeading  = locData.blogH    ?? hp?.blogSectionHeading ?? '';
const blogCta      = locData.blogCta  ?? hp?.blogCtaLabel      ?? 'Show all';

const allPosts = await getCollection('posts');
const posts = allPosts
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())
  .slice(0, 3);

const descriptions: Record<Locale, string> = {
  pl: '',
  en: 'Veterinary advice, animal health and pet care — written with passion by a veterinarian.',
  de: 'Tierärztliche Ratschläge, Tiergesundheit und Haustierpflege — mit Leidenschaft von einer Tierärztin verfasst.',
};
---

<BaseLayout
  title="Kolavet — Veterinary blog"
  description={descriptions[lang]}
  lang={lang}
>
  <Nav />

  <main id="main-content">
    <section class="py-24 text-center sm:py-14">
      <div class="mx-auto flex max-w-[768px] flex-col items-center gap-6 px-6">
        <Badge>{heroBadge}</Badge>
        <h1 class="font-serif text-[4rem] font-extrabold leading-[1.05] tracking-[-1.2px] text-bright sm:text-[3rem] sm:tracking-[-0.8px]">
          {heroHeadline}
        </h1>
        {heroSubtext && (
          <p class="max-w-[580px] text-lg leading-relaxed text-secondary">{heroSubtext}</p>
        )}
        <Button asChild>
          <a href={`/${lang}/blog`}>{heroCtaLabel}</a>
        </Button>
      </div>
    </section>

    <section class="pb-24">
      <div class="mx-auto max-w-[1200px] px-6">
        <div class="mb-8 flex items-baseline justify-between gap-4">
          <h2 class="font-serif text-[2.5rem] font-bold leading-snug tracking-[-0.6px] text-bright">
            {blogHeading}
          </h2>
          <a
            href={`/${lang}/blog`}
            class="shrink-0 text-sm font-semibold text-cyan transition-colors hover:text-cyan-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan"
          >
            {blogCta} →
          </a>
        </div>
        {posts.length > 0 ? (
          <ul class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3" role="list">
            {posts.map((post) => (
              <li>
                <PostCard
                  slug={post.id}
                  title={post.data.title}
                  publishDate={post.data.publishDate}
                  category={post.data.category}
                  excerpt={post.data.excerpt}
                  coverImage={post.data.coverImage}
                  basePath="/blog"
                  lang={lang}
                />
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-base text-secondary">{lang === 'de' ? 'Artikel erscheinen bald.' : 'Articles coming soon.'}</p>
        )}
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
