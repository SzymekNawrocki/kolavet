---
import fs from 'node:fs';
import path from 'node:path';
import { getCollection } from 'astro:content';
import { createReader } from '@keystatic/core/reader';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { PostCard } from '../components/PostCard';
import { Button } from '../components/ui/button';
import { Badge } from '../components/ui/badge';
import AboutTeaser from '../components/AboutTeaser.astro';
import NewsletterCTA from '../components/NewsletterCTA.astro';
import keystaticConfig from '../../keystatic.config';
import { calculateReadingTime } from '../lib/reading-time';

const reader = createReader(process.cwd(), keystaticConfig);
const homePage = await reader.singletons.homePage.read();

const heroBadge    = homePage?.heroBadgeLabel    ?? 'Blog weterynaryjny';
const heroHeadline = homePage?.heroHeadline       ?? 'Zdrowie Twojego pupila w dobrych rękach';
const heroSubtext  = homePage?.heroSubtext        ?? '';
const heroCtaLabel = homePage?.heroCtaLabel       ?? 'Przeglądaj artykuły';
const blogHeading  = homePage?.blogSectionHeading ?? 'Ostatnie artykuły';
const blogCta      = homePage?.blogCtaLabel       ?? 'Pokaż wszystkie';

const allPosts = await getCollection('posts');
const posts = allPosts
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())
  .slice(0, 3)
  .map(post => {
    let rawContent = '';
    try {
      rawContent = fs.readFileSync(
        path.join(process.cwd(), 'src/content/posts', `${post.id}.mdoc`), 'utf-8'
      );
    } catch {}
    return { ...post, readingTime: calculateReadingTime(rawContent, 'pl') };
  });
---

<BaseLayout
  title="Kolavet — Blog weterynaryjny Michaliny"
  description="Porady weterynaryjne, zdrowie zwierząt i opieka nad pupilami — pisane z pasją przez lekarza weterynarii."
>
  <Nav />

  <main id="main-content">
    <!-- Hero -->
    <section class="py-24 text-center sm:py-14">
      <div class="mx-auto flex max-w-[768px] flex-col items-center gap-6 px-6">

        <Badge>{heroBadge}</Badge>

        <h1 class="font-serif text-[4rem] font-extrabold leading-[1.05] tracking-[-1.2px] text-bright sm:text-[3rem] sm:tracking-[-0.8px]">
          {heroHeadline}
        </h1>

        {heroSubtext && (
          <p class="max-w-[580px] text-lg leading-relaxed text-secondary">
            {heroSubtext}
          </p>
        )}

        <Button asChild>
          <a href="/blog">{heroCtaLabel}</a>
        </Button>

      </div>
    </section>

    <!-- Latest posts -->
    <section class="pb-24">
      <div class="mx-auto max-w-[1200px] px-6">

        <div class="mb-8 flex items-baseline justify-between gap-4">
          <h2 class="font-serif text-[2.5rem] font-bold leading-snug tracking-[-0.6px] text-bright">
            {blogHeading}
          </h2>
          <a
            href="/blog"
            class="shrink-0 text-sm font-semibold text-cyan transition-colors hover:text-cyan-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan"
          >
            {blogCta} →
          </a>
        </div>

        {posts.length > 0 ? (
          <ul class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3" role="list">
            {posts.map((post) => (
              <li>
                <PostCard
                  slug={post.id}
                  title={post.data.title}
                  publishDate={post.data.publishDate}
                  category={post.data.category}
                  excerpt={post.data.excerpt}
                  coverImage={post.data.coverImage}
                  readingTime={post.readingTime}
                />
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-base text-secondary">Artykuły już wkrótce.</p>
        )}

      </div>
    </section>

    <AboutTeaser lang="pl" />
    <NewsletterCTA lang="pl" />

  </main>

  <Footer />
</BaseLayout>
