---
import '../styles/global.css';
import { getLocalePaths, LOCALES } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  lang?: string;
  ogImage?: string;
  canonicalUrl?: string;
  type?: 'website' | 'article';
  publishDate?: string;
}

const {
  title,
  description,
  lang = 'pl',
  ogImage = '/images/photo.jpeg',
  canonicalUrl = Astro.url.href,
  type = 'website',
  publishDate,
} = Astro.props;

const siteName = 'Kolavet — Blog weterynaryjny Michaliny';
const siteOrigin = Astro.site ?? new URL(Astro.url.origin);
const localePaths = getLocalePaths(Astro.url.pathname);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type"        content={type} />
    <meta property="og:site_name"   content={siteName} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={new URL(ogImage, Astro.site ?? Astro.url.origin).href} />
    <meta property="og:url"         content={canonicalUrl} />
    {publishDate && <meta property="article:published_time" content={publishDate} />}

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Geist:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- hreflang alternate links -->
    {LOCALES.map(locale => (
      <link rel="alternate" hreflang={locale} href={new URL(localePaths[locale], siteOrigin).href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(localePaths.pl, siteOrigin).href} />

    <!-- Sitemap & RSS -->
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Kolavet RSS" href="/rss.xml" />

    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
